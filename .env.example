# ── LLM ──────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LLM model to use ─────────────────────────────────────────
LLM_PROVIDER=google          # google | openai | anthropic
LLM_MODEL=gemini-2.0-flash

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_secret_key_in_production

# ── Database (SQLite for local dev, PostgreSQL for prod) ──────
DATABASE_URL=sqlite:///./experiment_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ml_agent_db

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=ml-experiment-agent

# ── Storage ──────────────────────────────────────────────────
DATA_DIR=./data
MODELS_DIR=./saved_models
REPORTS_DIR=./reports

# ── Agent Config ─────────────────────────────────────────────
MAX_EXPERIMENTS=10
TIME_BUDGET_MINUTES=30
DEFAULT_METRIC=f1
